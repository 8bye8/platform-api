meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

tests {
  test("stores the access token", function() {
    expect(res.getStatus()).to.equal(200);
    bru.setEnvVar("authToken", res.getBody());
  });
}
