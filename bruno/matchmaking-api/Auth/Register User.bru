meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "username": "{{username}}"
  }
}

tests {
  test("registers the user", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
